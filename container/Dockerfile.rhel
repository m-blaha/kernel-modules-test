# CentOS Stream includes the RPM-build tools needed by this suite (including
# createrepo_c). Use --base registry.redhat.io/rhel9/rhel:latest for a
# subscribed RHEL image.
ARG BASE=quay.io/centos/centos:stream9
FROM ${BASE}

RUN dnf -y install \
        createrepo_c \
        dnf \
        findutils \
        python3 \
        python3-pip \
        python3-rpm \
        rpm \
        rpm-build \
    && dnf clean all

WORKDIR /opt/partner-kmod-dnf-tests
COPY requirements.txt ./
RUN pip3 install --no-cache-dir -r requirements.txt
COPY . ./

# RPM fixture repositories are intentionally built by container-test run, so a
# source edit does not rely on RPMs baked into an earlier image layer.
ENTRYPOINT ["/bin/bash"]
